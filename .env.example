# ---- 服务 ----
APP_NAME=TraceQA
DEBUG=true

# ---- 数据库 ----
DATABASE_URL=postgresql+psycopg://tracingqa:tracingqa@db:5432/tracingqa

# ---- 嵌入（本地部署，离线可用）----
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_ENDPOINT=http://embedder:80

# ---- 重排 ----
# reranker 是独立服务（compose 里的 reranker，容器内 80，宿主机 9998）。
# 走 docker compose 用 http://reranker:80；本地 venv 直跑要改成 http://localhost:9998。
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_ENDPOINT=http://reranker:80
RERANK_MIN_SCORE=0.35
RERANK_FAIL_OPEN=true

# ---- LLM ----
# 没有 key 也能跑：pipeline 和检索不依赖 LLM，只有问答会失败。
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_BASE_URL=

# ---- 检索旋钮（evals 里的优化变量）----
RETRIEVE_K=50
RERANK_INPUT_K=20
TOP_N=5
RRF_K=60

# ---- 安全 ----
JWT_SECRET=please-change-this-in-production
JWT_TTL_SECONDS=43200

# ---- 观测 ----
OTEL_ENDPOINT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---- 镜像源（大陆网络建议开）----
# docker.io / ghcr.io 在国内直连不通。去掉注释即切到 daocloud 镜像站。
# DB_IMAGE=docker.m.daocloud.io/pgvector/pgvector:pg16
# TEI_IMAGE=ghcr.m.daocloud.io/huggingface/text-embeddings-inference:cpu-1.6
# HF_ENDPOINT=https://hf-mirror.com
